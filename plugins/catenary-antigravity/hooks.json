{
  "catenary-editing": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "catenary hook pre-invocation --format=antigravity"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook pre-tool --format=antigravity"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "catenary hook post-agent --format=antigravity"
      }
    ]
  },
  "catenary-reserved": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook post-tool-use --format=antigravity || printf '%s' '{}'"
          }
        ]
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "catenary hook post-invocation --format=antigravity || printf '%s' '{}'"
      }
    ]
  }
}
