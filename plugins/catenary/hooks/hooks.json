{
  "description": "LSP diagnostics and editing state enforcement via catenary hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook session-start --format=claude || { (notify-send Catenary 'catenary binary not found on PATH. Install it, then start a new session.' || osascript -e 'display notification \"catenary binary not found on PATH. Install it, then start a new session.\" with title \"Catenary\"') >/dev/null 2>&1; if command -v brew >/dev/null 2>&1; then printf '%s' '{\"systemMessage\":\"Catenary hooks are installed but the catenary binary was not found on PATH. Install it with: brew install twowells/tap/catenary. Then start a new session so the hooks and MCP server connect.\"}'; else printf '%s' '{\"systemMessage\":\"Catenary hooks are installed but the catenary binary was not found on PATH. Install it with: curl -fsSL https://raw.githubusercontent.com/TwoWells/Catenary/main/install.sh | sh. Then start a new session so the hooks and MCP server connect.\"}'; fi; }"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook pre-tool --format=claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook post-agent --format=claude"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook post-agent --format=claude"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook session-end --format=claude"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook subagent-start --format=claude"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook worktree-remove --format=claude"
          }
        ]
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook worktree-create --format=claude"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook permission-request --format=claude"
          }
        ]
      }
    ],
    "Setup": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook setup --format=claude || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook user-prompt-submit --format=claude || true"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook user-prompt-expansion --format=claude || true"
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook permission-denied --format=claude || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook post-tool-use --format=claude || true"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook post-tool-use-failure --format=claude || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook notification --format=claude || true"
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "catenary hook task-created --format=claude || true"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
